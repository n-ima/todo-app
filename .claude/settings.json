{
  "permissions": {
    "deny": [
      "Edit(.github/agents/**)",
      "Write(.github/agents/**)",
      "Edit(.github/hooks/**)",
      "Write(.github/hooks/**)",
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)",
      "Edit(.github/prompts/**)",
      "Write(.github/prompts/**)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Write(.claude/settings.local.json)",
      "Edit(.claude/skills/request-routing/**)",
      "Write(.claude/skills/request-routing/**)",
      "Edit(.claude/skills/gate-check/**)",
      "Write(.claude/skills/gate-check/**)",
      "Edit(.github/skills/request-routing/**)",
      "Write(.github/skills/request-routing/**)",
      "Edit(.github/skills/gate-check/**)",
      "Write(.github/skills/gate-check/**)",
      "Edit(.github/harness/PLATFORM.md)",
      "Write(.github/harness/PLATFORM.md)",
      "Edit(.github/instructions/**)",
      "Write(.github/instructions/**)",
      "Edit(.claude/agents/**)",
      "Write(.claude/agents/**)",
      "Edit(.claude/commands/**)",
      "Write(.claude/commands/**)",
      "Edit(.agents/workflows/**)",
      "Write(.agents/workflows/**)",
      "Edit(AGENTS.md)",
      "Write(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(plugin.json)",
      "Write(plugin.json)",
      "Edit(.claude-plugin/**)",
      "Write(.claude-plugin/**)",
      "Edit(.vscode/settings.json)",
      "Write(.vscode/settings.json)",
      "Edit(docs/**/*_template.md)",
      "Write(docs/**/*_template.md)",
      "Edit(.github/harness/model-policy.yml)",
      "Write(.github/harness/model-policy.yml)",
      "Edit(.github/copilot/**)",
      "Write(.github/copilot/**)",
      "Edit(.claude/rules/**)",
      "Write(.claude/rules/**)",
      "Edit(.github/copilot-instructions.md)",
      "Write(.github/copilot-instructions.md)",
      "Edit(CLAUDE.local.md)",
      "Write(CLAUDE.local.md)",
      "Edit(GEMINI.md)",
      "Write(GEMINI.md)",
      "Edit(.github/harness/external-lock.json)",
      "Write(.github/harness/external-lock.json)",
      "Agent(model:haiku)",
      "Agent(model:claude-haiku-4-5)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git reset --hard:*)",
      "PowerShell(git push:*)",
      "PowerShell(git tag:*)",
      "PowerShell(git reset --hard:*)",
      "Bash(ln -s:*)",
      "Bash(mklink:*)",
      "PowerShell(mklink:*)",
      "PowerShell(New-Item -ItemType SymbolicLink:*)",
      "PowerShell(New-Item -ItemType Junction:*)",
      "Bash(npm publish:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(docker push:*)",
      "Bash(gh release create:*)",
      "Bash(gh pr merge:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "PowerShell(npm publish:*)",
      "PowerShell(terraform apply:*)",
      "PowerShell(kubectl apply:*)",
      "PowerShell(docker push:*)",
      "PowerShell(gh release create:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash .github/hooks/scripts/run-python.sh .github/hooks/scripts/statusline.py"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/guard-template-edit.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/guard-harness-config-edit.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/guard-secret-leak.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/guard-phase-scope.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/guard-done-evidence.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/guard-dangerous-git.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/guard-secret-leak.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/guard-harness-config-edit.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/guard-external-effect.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/guard-subagent-model.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/guard-external-effect.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/warn-stale-gate.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/check-doc-chars.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/warn-gate-tamper.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/run-python.sh .github/hooks/scripts/log-subagent.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/inject-progress.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/run-python.sh .github/hooks/scripts/session-baseline.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/inject-progress.sh PreCompact",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/route-request.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/run-python.sh .github/hooks/scripts/remind-record.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/run-python.sh .github/hooks/scripts/log-effort.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/run-python.sh .github/hooks/scripts/draft-learnings.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/run-python.sh .github/hooks/scripts/remind-session-boundary.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/run-python.sh .github/hooks/scripts/log-subagent.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/run-python.sh .github/hooks/scripts/guard-subagent-output.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/run-python.sh .github/hooks/scripts/log-effort.py",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/run-python.sh .github/hooks/scripts/mark-abnormal-stop.py",
            "timeout": 10
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "matcher": "session_start|compact|include",
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/run-python.sh .github/hooks/scripts/log-instructions-loaded.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/run-python.sh .github/hooks/scripts/log-model-switch.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/run-python.sh .github/hooks/scripts/log-model-switch.py",
            "timeout": 5
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "project_settings|local_settings|skills",
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/run-python.sh .github/hooks/scripts/guard-config-change.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
