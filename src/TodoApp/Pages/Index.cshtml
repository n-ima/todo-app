@page "/"
@model TodoApp.Pages.IndexModel
@{
    ViewData["Title"] = "タスク一覧";
    var isAdmin = User.IsInRole("admin");
    var f = Model.Filter;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
@section Scripts {
    <script type="module" src="/js/tree.js"></script>
}
<h1>タスク一覧</h1>
<div class="toprow">
    @* 絞り込みに関係なく全体で数える。クリックで他の条件を外して期限超過だけにする（DD-06 §6） *@
    <a class="btn@(Model.View.OverdueCount > 0 ? " overdue-btn" : "")" href="/?overdue=1" title="絞り込みに関係なく全タスクで数えています">@(Model.View.OverdueCount > 0 ? "! " : "")期限超過 @Model.View.OverdueCount 件</a>
    <span class="spacer"></span>
    <a class="btn" href="/calendar@(ViewData["NavQuery"])">カレンダーで見る</a>
    @if (isAdmin)
    {
        <button type="button" class="btn primary hide-sp" data-dialog-open="new-project">＋プロジェクト</button>
        <dialog id="new-project" aria-labelledby="new-project-title">
            <h2 id="new-project-title">プロジェクトの作成</h2>
            <form method="post" asp-page="/Admin/Projects" asp-page-handler="Create">
                <input type="hidden" name="returnToList" value="true">
                <p><label for="new-project-name">プロジェクト名（1〜100 文字）</label><br><input id="new-project-name" name="name" maxlength="100" required></p>
                <div class="row">
                    <button type="submit" class="btn primary">作成する</button>
                    <button type="button" class="btn" data-close>キャンセル</button>
                </div>
            </form>
        </dialog>
    }
</div>
<form class="filters" method="get" action="/" aria-label="絞り込み">
    <label>担当者<select name="assignee">
        <option value="">すべて</option>
        <option value="none" selected="@f.AssigneeNone">未設定</option>
        @foreach (var u in Model.View.Users.OrderBy(u => !u.IsActive).ThenBy(u => u.DisplayName, StringComparer.Ordinal))
        {
            <option value="@u.Id" selected="@(f.AssigneeId == u.Id)">@(u.IsActive ? "" : "（無効）")@u.DisplayName</option>
        }
    </select></label>
    <label class="adv">状態<select name="status" multiple size="3" title="Ctrl で複数選択">
        @foreach (var st in Model.View.Statuses)
        {
            <option value="@st.Id" selected="@f.StatusIds.Contains(st.Id)">@st.Name</option>
        }
    </select></label>
    <label class="adv">期限（から）<input type="date" name="dueFrom" value="@f.DueFrom?.ToString("yyyy-MM-dd", inv)"></label>
    <label class="adv">期限（まで）<input type="date" name="dueTo" value="@f.DueTo?.ToString("yyyy-MM-dd", inv)"></label>
    <label>キーワード<input type="search" name="q" value="@f.Q" maxlength="100" placeholder="タイトルを検索" size="16"></label>
    <label class="chk"><input type="checkbox" name="memo" value="1" checked="@f.Memo"> メモも検索</label>
    <label class="chk"><input type="checkbox" name="mine" value="1" checked="@f.Mine"> 自分の担当だけ</label>
    <label class="chk"><input type="checkbox" name="done" value="1" checked="@(f.Done || Model.View.Statuses.Any(st => st.IsDone && f.StatusIds.Contains(st.Id)))"> 完了も表示</label>
    @if (f.Overdue)
    {
        <label class="chk"><input type="checkbox" name="overdue" value="1" checked> 期限超過だけ</label>
    }
    <label>並び順<select name="sort">
        <option value="due">期限の昇順</option>
        <option value="manual" selected="@f.ManualSort">手動順</option>
    </select></label>
    <button type="submit" class="btn">絞り込む</button>
    <a class="btn" href="/">絞り込みを解除</a>
</form>
@if (Model.View.Notice is not null)
{
    <p class="note" role="status">@Model.View.Notice</p>
}
@if (Model.View.EmptyMessage is not null)
{
    <div class="empty">
        @Model.View.EmptyMessage
        @if (isAdmin && Model.View.Projects.Count == 0)
        {
            <br><span class="note">「＋プロジェクト」から最初のプロジェクトを作成してください</span>
        }
    </div>
}
else
{
    <table id="tree" class="tree" aria-label="タスクの階層">
        <thead><tr><th>タイトル</th><th>状態</th><th>担当者</th><th>期限</th><th>優先度</th><th class="ops">操作</th></tr></thead>
        <tbody>
            @foreach (var project in Model.View.Projects)
            {
                <tr class="project" data-lv="0">
                    <td colspan="5"><div class="tt"><button type="button" class="tog@(project.Rows.Count == 0 ? " none" : "")" aria-expanded="true" aria-label="開閉">▾</button>@project.Name</div></td>
                    <td class="ops">
                        <a class="btn small" href="/projects/@project.Id/tasks/new">＋タスク</a>
                        @if (isAdmin)
                        {
                            <a class="btn small" href="/admin/projects">名前変更・削除</a>
                        }
                    </td>
                </tr>
                <partial name="_TaskRows" model="project.Rows" />
            }
        </tbody>
    </table>
}
