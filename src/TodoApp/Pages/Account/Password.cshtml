@page "/account/password"
@model TodoApp.Pages.Account.PasswordModel
@{
    ViewData["Title"] = "パスワード変更";
    ViewData["HideNav"] = Model.IsFirstChange;
}
<h1>パスワード変更</h1>
@if (Model.IsFirstChange)
{
    <p class="flash">@ErrorIds.Messages[ErrorIds.AuthMustChange]</p>
}
@if (Model.ErrorId is not null)
{
    <div class="error-summary" role="alert">
        <p class="error-message">@ErrorIds.Messages[Model.ErrorId] <small class="error-id">（@Model.ErrorId）</small></p>
    </div>
}
<form method="post" class="login-form">
    <p>
        <label for="currentPassword">現在のパスワード</label><br>
        <input id="currentPassword" name="currentPassword" type="password" maxlength="128" autocomplete="current-password" required autofocus>
    </p>
    <p>
        <label for="newPassword">新しいパスワード（8〜128 文字）</label><br>
        <input id="newPassword" name="newPassword" type="password" maxlength="128" autocomplete="new-password" required>
    </p>
    <p>
        <label for="newPasswordConfirm">新しいパスワード（確認）</label><br>
        <input id="newPasswordConfirm" name="newPasswordConfirm" type="password" maxlength="128" autocomplete="new-password" required>
    </p>
    <p><button type="submit" class="btn primary">変更する</button></p>
</form>
