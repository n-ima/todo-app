{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/guard-template-edit.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/guard-harness-config-edit.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/guard-secret-leak.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/guard-phase-scope.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/guard-done-evidence.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/guard-dangerous-git.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/guard-secret-leak.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/guard-harness-config-edit.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/guard-external-effect.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/guard-subagent-model.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/guard-external-effect.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/warn-stale-gate.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/check-doc-chars.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/warn-gate-tamper.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/log-subagent.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/notify.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/inject-progress.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/session-baseline.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/inject-progress.sh\" PreCompact",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/route-request.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/remind-record.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/log-effort.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/draft-learnings.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/remind-session-boundary.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/log-subagent.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/guard-subagent-output.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/log-effort.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/mark-abnormal-stop.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "matcher": "session_start|compact|include",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/log-instructions-loaded.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/log-model-switch.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/log-model-switch.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "project_settings|local_settings|skills",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/.github/hooks/scripts/guard-config-change.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
